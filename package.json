{
  "name": "oxidation-kinetics-service",
  "version": "1.0.0",
  "private": true,
  "description": "高温氧化膜厚度核算服务：抛物律 / 线性律膜厚、Arrhenius 温度修正、质量增益换算、Pilling–Bedworth 适用性判定",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
